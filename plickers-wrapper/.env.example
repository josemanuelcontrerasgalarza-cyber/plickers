# ─────────────────────────────────────────────
#  KRATOS LABS — Plickers Wrapper · .env config
# ─────────────────────────────────────────────
PLICKERS_EMAIL=tu_email@ejemplo.com
# Si tu cuenta usa "Iniciar sesión con Google" / SSO, deja PLICKERS_PASSWORD
# vacío y ejecuta `npm run login` UNA vez para generar plickers.session.json.
# Si usas email + password clásico, complétalo aquí.
PLICKERS_PASSWORD=
PLICKERS_CLASS_ID=
PORT=3000
NODE_ENV=development
API_SECRET_KEY=kratos-secret-local-key-cambiar-esto
HEADLESS=true
SCRAPER_TIMEOUT=30000
# (opcional) Ruta personalizada del archivo de sesión guardada.
# Por defecto: ./plickers.session.json en la raíz del proyecto.
PLICKERS_SESSION_PATH=
